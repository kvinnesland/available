# Kopier til .env lokalt, eller legg inn som Environment Variables i Coolify.
# Ingen av verdiene her er ekte.

# Hemmelig iCal-adresse til felleskalenderen i Google Kalender. Flere: skill med komma.
# Kan stå tom ved første deploy.
ICS_SHARED=

# Minst 24 tegn. Generer med: python3 -c "import secrets;print(secrets.token_urlsafe(24))"
VISITOR_KEY=

ADMIN_USER=
# Minst 16 tegn. Generer med: python3 -c "import secrets;print(secrets.token_urlsafe(18))"
ADMIN_PASSWORD=

# Adressen besøkende sender forespørsel til
CONTACT_EMAIL=

TZ_LOCAL=Europe/Oslo
NIGHT_START=18:00
NIGHT_END=09:00
HORIZON_DAYS=365
REFRESH_MINUTES=15
